# Vercel environment variables template
# 说明：把尖括号内的占位符替换为真实值，并确保 Mongo 密码已 URL-encode（见下方说明）。

# MongoDB 连接字符串（替换 <DB_USER>, <ENCODED_PASSWORD>, <CLUSTER_HOST>）
MONGODB_URI=mongodb+srv://<DB_USER>:<ENCODED_PASSWORD>@<CLUSTER_HOST>/usdt_trading?retryWrites=true&w=majority

# 数据库名
MONGODB_DB=usdt_trading

# JWT 签名密钥（把下面替换成实际生成的 secret）
JWT_SECRET=<PASTE_JWT_SECRET_HERE>

# 同步接口签名密钥（用于 /api/sync/* 的校验）
SYNC_SECRET=<PASTE_SYNC_SECRET_HERE>

# 运行环境
NODE_ENV=production

# 可选：前端访问地址（若有自定义域）
APP_PUBLIC_URL=https://your-app-domain.example.com

# 下面为说明（不要复制到 Vercel）
# ---------------------------
# 如何生成与替换说明：
# 1) 将 Mongo 密码 URL encode（PowerShell 示例）:
#    [System.Uri]::EscapeDataString('YourP@ssw0rd!')
#    把输出拷贝到 <ENCODED_PASSWORD> 位置。
# 2) 生成随机 secret（Node.js）:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  # JWT_SECRET
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  # SYNC_SECRET
# 3) 在 Vercel 控制台：Project -> Settings -> Environment Variables，逐行添加上面的 KEY/Value。
# 4) 如果需要快速用 vercel CLI 批量添加，请参考仓库下的 scripts/setup-vercel-envs.ps1。
# 5) 不要把真实 secrets 上传到公开仓库。如果需要自动化，请在本地运行脚本并在运行时输入 token。